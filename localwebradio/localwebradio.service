[Unit]
Description=Local Web Radio
After=network.target

[Service]
Type=simple

User=nitro
Group=nitro

WorkingDirectory=/opt/localwebradio
ExecStart=/usr/bin/node /opt/localwebradio/main.js

Restart=always
RestartSec=5

Environment=NODE_ENV=production

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target